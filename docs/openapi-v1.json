  "info": {
    "title": "Foxhole Stockpiles Server",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/scan": {
      "post": {
        "description": "Run server-side OCR on uploaded image bytes and deliver the result.\n\nArgs:\n    request (Request): The request; body is the raw image bytes, with\n        ``Content-Type: image/*`` and optional ``X-Foxhole-Capture-Id`` /\n        ``X-Foxhole-Language`` headers.\n\nReturns:\n    ScanResponse: The detected stockpile plus per-branch delivery reports.\n\nRaises:\n    HTTPException: 503 ``ocr_disabled``; 400 ``invalid_content_type`` /\n        ``image_too_large`` / ``invalid_image``; 500 ``ocr_failed``.",
        "operationId": "scan_api_v1_scan_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Scan"
      }
    },
    "/api/v1/schema": {
      "get": {
        "description": "Return the wire JSON schemas.\n\nReturns:\n    SchemaResponse: Cached schemas for Stockpile and the request/response models.",
        "operationId": "schema_api_v1_schema_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Schema"
      }
    },
    "/api/v1/stockpiles": {
      "post": {
        "description": "Run the server's output branches over pre-processed stockpiles.\n\nArgs:\n    request (Request): The incoming request.\n    payload (StockpilesRequest): The validated request body.\n\nReturns:\n    StockpilesResponse: Acceptance count and per-branch delivery reports.",
        "operationId": "stockpiles_api_v1_stockpiles_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockpilesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockpilesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stockpiles"
      }
    },
    "/health": {
      "get": {
        "description": "Report liveness, version, and enabled features.\n\nArgs:\n    request (Request): The incoming request.\n\nReturns:\n    HealthResponse: The liveness payload.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
