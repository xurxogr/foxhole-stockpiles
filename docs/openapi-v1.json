{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Response for ``GET /health``.\n\nAttributes:\n    status (Literal[\"ok\"]): Liveness marker.\n    version (str): Server version string.\n    ocr_enabled (bool): Whether ``/api/v1/scan`` can serve requests.\n    features (list[str]): Enabled feature identifiers.\n    uptime_seconds (float): Seconds since the process started serving.",
        "properties": {
          "features": {
            "items": {
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "ocr_enabled": {
            "title": "Ocr Enabled",
            "type": "boolean"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "uptime_seconds": {
            "title": "Uptime Seconds",
            "type": "number"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "ocr_enabled",
          "features",
          "uptime_seconds"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ItemCandidate-Input": {
        "additionalProperties": false,
        "description": "Alternative candidate for an item match.",
        "example": {
          "code": "RifleAlternative",
          "confidence": 0.92
        },
        "properties": {
          "code": {
            "description": "Code of the alternative candidate item",
            "title": "Code",
            "type": "string"
          },
          "confidence": {
            "description": "Confidence score of the alternative candidate",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          }
        },
        "required": [
          "code",
          "confidence"
        ],
        "title": "ItemCandidate",
        "type": "object"
      },
      "ItemCandidate-Output": {
        "additionalProperties": false,
        "description": "Alternative candidate for an item match.",
        "example": {
          "code": "RifleAlternative",
          "confidence": 0.92
        },
        "properties": {
          "code": {
            "description": "Code of the alternative candidate item",
            "title": "Code",
            "type": "string"
          },
          "confidence": {
            "description": "Confidence score of the alternative candidate",
            "title": "Confidence",
            "type": "number"
          }
        },
        "required": [
          "code",
          "confidence"
        ],
        "title": "ItemCandidate",
        "type": "object"
      },
      "OutputEmissionReport": {
        "description": "Per-branch outcome of flushing stockpiles through the server's outputs.\n\nAttributes:\n    branch (str): The branch name.\n    status (Literal[\"ok\", \"skipped\", \"failed\"]): Delivery outcome.\n    error (str | None): Failure message or skip reason. Defaults to None.\n    response (SinkResult | None): The sink's downstream response (e.g. the\n        webhook reply) when one exists. Defaults to None.",
        "properties": {
          "branch": {
            "title": "Branch",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "response": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SinkResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ok",
              "skipped",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "branch",
          "status"
        ],
        "title": "OutputEmissionReport",
        "type": "object"
      },
      "ScanResponse": {
        "description": "Response for ``POST /api/v1/scan``.\n\nAttributes:\n    capture_id (str | None): Echoed client correlation token.\n    stockpile (Stockpile): The single stockpile detected in the image.\n    server_outputs (list[OutputEmissionReport]): Per-branch delivery results.",
        "properties": {
          "capture_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capture Id"
          },
          "server_outputs": {
            "items": {
              "$ref": "#/components/schemas/OutputEmissionReport"
            },
            "title": "Server Outputs",
            "type": "array"
          },
          "stockpile": {
            "$ref": "#/components/schemas/Stockpile-Output"
          }
        },
        "required": [
          "stockpile",
          "server_outputs"
        ],
        "title": "ScanResponse",
        "type": "object"
      },
      "SchemaResponse": {
        "description": "Response for ``GET /api/v1/schema``.\n\nAttributes:\n    stockpile (dict[str, Any]): JSON schema of :class:`Stockpile`.\n    scan_response (dict[str, Any]): JSON schema of :class:`ScanResponse`.\n    stockpiles_request (dict[str, Any]): JSON schema of :class:`StockpilesRequest`.",
        "properties": {
          "scan_response": {
            "additionalProperties": true,
            "title": "Scan Response",
            "type": "object"
          },
          "stockpile": {
            "additionalProperties": true,
            "title": "Stockpile",
            "type": "object"
          },
          "stockpiles_request": {
            "additionalProperties": true,
            "title": "Stockpiles Request",
            "type": "object"
          }
        },
        "required": [
          "stockpile",
          "scan_response",
          "stockpiles_request"
        ],
        "title": "SchemaResponse",
        "type": "object"
      },
      "SinkResult": {
        "description": "The downstream response a sink received while delivering output.\n\nNetwork-backed sinks (webhook, http-upload) populate this from the remote\nreply so callers (notably ``POST /api/v1/scan``) can surface it. Local sinks\n(file, stdout) have no meaningful response and return ``None`` instead.\n\nAttributes:\n    status_code (int | None): The downstream HTTP status code, if any.\n    body (str | None): The downstream response body as text, if any.\n    content_type (str | None): The downstream response Content-Type, if any.",
        "properties": {
          "body": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "status_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Code"
          }
        },
        "title": "SinkResult",
        "type": "object"
      },
